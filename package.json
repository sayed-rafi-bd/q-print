{
  "name": "q-print",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "icons": "tauri icon app-icon.png",
    "dev:android": "tauri android dev",
    "android:init": "tauri android init",
    "build:windows": "tauri build && node scripts/collect-releases.mjs windows",
    "build:linux": "tauri build && node scripts/collect-releases.mjs linux",
    "build:android": "tauri android build --apk --split-per-abi && node scripts/collect-releases.mjs android",
    "build:android:debug": "tauri android build --debug --apk --target aarch64 && node scripts/collect-releases.mjs android",
    "build:android:aab": "tauri android build --aab --split-per-abi && node scripts/collect-releases.mjs android",
    "releases:collect": "node scripts/collect-releases.mjs",
    "releases:clean": "node scripts/clean-releases.mjs",
    "version:major": "node scripts/bump-version.mjs major",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:set": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@pdfme/common": "^5.2.0",
    "@pdfme/generator": "^5.2.0",
    "@pdfme/schemas": "^5.2.0",
    "@pdfme/ui": "^5.2.0",
    "@tauri-apps/api": "^2",
    "drizzle-orm": "^0.45.4",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  }
}
